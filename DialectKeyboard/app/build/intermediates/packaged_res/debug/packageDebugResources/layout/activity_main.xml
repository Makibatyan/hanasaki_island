<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="方言キーボード 設定"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="方言キーボードを使用するには、以下の2つのステップを設定してください。"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <!-- ステップ1: 有効化 -->
    <Button
        android:id="@+id/btn_enable"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="1. キーボードを有効にする"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- ステップ2: 切り替え -->
    <Button
        android:id="@+id/btn_switch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="2. 方言キーボードを選択する"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#10B981"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp" />

    <!-- 入力テスト欄 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="入力テスト"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="ここをタップして入力テストができます"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textColor="#1F2937" />

</LinearLayout>