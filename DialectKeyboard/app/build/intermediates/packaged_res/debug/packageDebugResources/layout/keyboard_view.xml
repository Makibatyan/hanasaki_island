<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 通常のキーボードレイアウト -->
    <LinearLayout
        android:id="@+id/layout_keyboard_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D1D5DB">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#E5E7EB"
            android:gravity="center_vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_candidates"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp" />

            <Button
                android:id="@+id/btn_select_region"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="地域選択"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#2563EB"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <com.example.dialectkeyboard.FlickKeyboardView
            android:id="@+id/flick_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
    </LinearLayout>

    <!-- 地域選択用オーバーレイパネル -->
    <LinearLayout
        android:id="@+id/layout_region_panel"
        android:layout_width="match_parent"
        android:layout_height="264dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="地域を選択（地方一括・個別県）"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:paddingStart="4dp" />

            <Button
                android:id="@+id/btn_panel_apply"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="決定"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#10B981"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/container_region_checks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>